services:
  qdrant:
    image: qdrant/qdrant:latest
    container_name: profia-qdrant
    ports:
      - "6333:6333"
      - "6334:6334"
    volumes:
          volumes:
      - ./qdrant_data:/qdrant/storage
    restart: unless-stopped
    networks:
      - profia-networ

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: profia-backend
    ports:
      - "8000:8000"
    environment:
      - QDRANT_HOST=qdrant
      - QDRANT_PORT=6333
    env_file:
      - ./backend/.env
    volumes:
      - ./backend/storage/uploads:/app/storage/uploads
    depends_on:
      - qdrant
    restart: unless-stopped
    networks:
      - profia-network

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
      args:
        - NEXT_PUBLIC_API_URL=http://localhost:8000
    container_name: profia-frontend
    ports:
      - "3000:3000"    # <-- A LINHA QUE GARANTE O ACESSO
    environment:
      - NEXT_PUBLIC_API_URL=http://localhost:8000
    depends_on:
      - backend
    restart: unless-stopped
    networks:
      - profia-network

volumes:
  qdrant_storage:

networks:
  profia-network:
    driver: bridge
